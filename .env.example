# App
APP_NAME=crypto-pay
APP_URI=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crypto_pay

# Auth (better-auth)
BETTER_AUTH_SECRET=your-secret-key-change-this
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Server
PORT=8000
LOG_LEVEL=info

# Rate
FORCED_USDT_RATE=7.2
# RATE_API_URL=https://api.coingecko.com/api/v3/simple/price

# Order
ORDER_EXPIRATION_MINUTES=10
ORDER_NOTICE_MAX_RETRY=5

